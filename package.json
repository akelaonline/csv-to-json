{
  "name": "ai-data-prep-converter",
  "version": "2.0.0",
  "description": "Securely convert XLSX, XLS, CSV, PDF and TXT files into JSON or JSONL for RAG, agents and LLM data pipelines.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "keywords": [
    "rag",
    "jsonl",
    "csv",
    "xlsx",
    "xls",
    "pdf",
    "llm",
    "openai",
    "data-prep"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.6",
    "csv-parser": "3.2.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "multer": "2.2.0",
    "pdf-parse": "2.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
