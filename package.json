{
  "name": "ai-data-prep-converter",
  "version": "2.0.1",
  "private": true,
  "description": "Self-hosted converter for turning XLSX, XLS, CSV, PDF and TXT files into secure JSON/JSONL datasets for RAG, AI agents and LLM pipelines.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "keywords": [
    "rag",
    "llm",
    "ai-agents",
    "data-preparation",
    "document-processing",
    "etl",
    "json",
    "jsonl",
    "csv",
    "xlsx",
    "xls",
    "pdf",
    "vector-database",
    "knowledge-base",
    "nodejs",
    "express",
    "docker",
    "self-hosted",
    "n8n",
    "automation",
    "openai"
  ],
  "author": "Alejandro Daniel José · Akela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akelaonline/csv-to-json.git"
  },
  "bugs": {
    "url": "https://github.com/akelaonline/csv-to-json/issues"
  },
  "homepage": "https://github.com/akelaonline/csv-to-json#readme",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.6",
    "csv-parser": "3.2.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "multer": "2.2.0",
    "pdf-parse": "2.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
